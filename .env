# Selectores de build. Ver docs/architecture/ARCHITECTURE.md §5.
#
# ⚠️ NUNCA pongas aquí una credencial. Todo lo que empiece por VITE_ acaba en
# el bundle y es PÚBLICO, aunque el repositorio sea privado.
# Ver docs/architecture/PAYMENTS.md §1.
#
# Para valores locales que no quieras versionar, usa .env.local (ignorado).

# Cliente a construir. Debe existir en clients/<slug>/
VITE_CLIENT=demo

# demo | production. Si falta, se asume demo (el default seguro).
VITE_MODE=demo
